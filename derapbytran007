-- Kiểu hitbox
local hitboxType = "Circle"
circleBtn.MouseButton1Click:Connect(function() hitboxType = "Circle" end)
lineBtn.MouseButton1Click:Connect(function() hitboxType = "Line" end)

-- Hitbox Part
local vis
local function createHitbox()
	if vis then vis:Destroy() end
	vis = Instance.new("Part", Workspace)
	vis.Anchored = true
	vis.CanCollide = false
	vis.Material = Enum.Material.ForceField
	vis.Transparency = 0.6
	vis.CastShadow = false
	vis.BottomSurface = Enum.SurfaceType.Smooth
	vis.TopSurface = Enum.SurfaceType.Smooth
end

-- Gây damage
local function hit(p,h)
	local c = p.Parent
	local hum = c and c:FindFirstChildOfClass("Humanoid")
	if hum and c.Name ~= plr.Name then
		for _,part in pairs(c:GetChildren()) do
			if part:IsA("BasePart") then
				firetouchinterest(part,h,0)
				firetouchinterest(part,h,1)
			end
		end
	end
end

-- RenderStepped
local hue = 0
RunService.RenderStepped:Connect(function()
	hue = (hue + 0.002) % 1

	local tool = plr.Character and plr.Character:FindFirstChild("Sword")
	if not tool then
		if vis then vis:Destroy() vis=nil end
		return
	end

	local h = tool:FindFirstChild("Handle")
	if not h then return end
	if not vis then createHitbox() end

	local r = tonumber(b.Text) or 5
	if r > 2000 then r = 2000 b.Text="2000" end
	if r < 1 then r=1 b.Text="1" end

	vis.Color = Color3.fromHSV(hue,1,1)

	if hitboxType=="Circle" then
		vis.Shape = Enum.PartType.Ball
		vis.Size = Vector3.new(r,r,r)
		vis.CFrame = h.CFrame
	else
		-- Đường thẳng phóng theo hướng kiếm (trước mặt, không ra sau lưng)
		vis.Shape = Enum.PartType.Block
		local length = r
		local width = 2
		vis.Size = Vector3.new(width, width, length)
		local forward = -h.CFrame.LookVector -- đảo hướng để ra phía trước kiếm
		local pos = h.Position + forward * (length / 2)
		vis.CFrame = CFrame.new(pos, pos + forward)
	end

	-- Gây damage
	for _,v in pairs(Players:GetPlayers()) do
		if v ~= plr and v.Team and plr.Team and v.Team ~= plr.Team then
			local hrp = v.Character and v.Character:FindFirstChild("HumanoidRootPart")
			if hrp and h then
				if hitboxType=="Circle" then
					if (hrp.Position - h.Position).Magnitude <= r then
						pcall(function() hit(hrp,h) end)
					end
				else
					local dist = (hrp.Position - h.Position).Magnitude
					if dist <= r then
						pcall(function() hit(hrp,h) end)
					end
				end
			end
		end
	end
end)
