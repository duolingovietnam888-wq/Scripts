-- nút đổi kiểu hitbox
local mode = Instance.new("TextButton", frame)
mode.Size = UDim2.new(0, 140, 0, 25)
mode.Position = UDim2.new(0, 10, 0, 45)
mode.Text = "Kiểu: Đường thẳng"
mode.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
mode.TextColor3 = Color3.fromRGB(255, 255, 255)

-- label tạm “By Tran & An”
local bylabel = Instance.new("TextLabel", gui)
