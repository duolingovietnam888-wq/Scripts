-- ESP logic
local espEnabled = false
local espObjects = {}
local function pointToLineDistance(point,lineStart,lineEnd)
	local lineDir = lineEnd - lineStart
	local lineLength = lineDir.Magnitude
	if lineLength == 0 then return (point - lineStart).Magnitude end
	local t = ((point - lineStart):Dot(lineDir)) / (lineLength^2)
	t = math.clamp(t,0,1)
	local projection = lineStart + lineDir * t
	return (point - projection).Magnitude
end
local function createESP(player)
	if not player.Character then return end
	local hum = player.Character:FindFirstChildOfClass("Humanoid")
	local hrp = player.Character:FindFirstChild("HumanoidRootPart")
	if not hum or not hrp then return end
	if not player.Team then return end
	local outline = Instance.new("Highlight")
	outline.Adornee = player.Character
	outline.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
	outline.FillTransparency = 1
	outline.OutlineTransparency = 0
	outline.OutlineColor = player.Team.Name == "Red" and Color3.fromRGB(255,50,50) or Color3.fromRGB(50,120,255)
	outline.Parent = gui
	local billboard = Instance.new("BillboardGui")
	billboard.Adornee = hrp
	billboard.Size = UDim2.new(0,60,0,20)
	billboard.StudsOffset = Vector3.new(0,3,0)
	billboard.AlwaysOnTop = true
	local textLabel = Instance.new("TextLabel",billboard)
	textLabel.Size = UDim2.new(1,0,1,0)
	textLabel.BackgroundTransparency = 1
	textLabel.Font = Enum.Font.GothamBold
	textLabel.TextScaled = true
	textLabel.TextColor3 = player.Team.Name == "Red" and Color3.fromRGB(255,70,70) or Color3.fromRGB(0,255,180)
	textLabel.Text = tostring(math.floor(hum.Health))
	hum.HealthChanged:Connect(function(hp) textLabel.Text = tostring(math.floor(hp)) end)
	billboard.Parent = gui
	espObjects[player] = {outline,billboard}
end
local function clearESP(player)
	if espObjects[player] then
		for _,obj in pairs(espObjects[player]) do if obj and obj.Parent then obj:Destroy() end end
		espObjects[player]=nil
	end
end

espBtn.MouseButton1Click:Connect(function()
	espEnabled = not espEnabled
	espBtn.Text = espEnabled and "ESP: ON" or "ESP: OFF"
	espBtn.BackgroundColor3 = espEnabled and Color3.fromRGB(0,50,25) or Color3.fromRGB(10,25,35)
	for _,p in pairs(Players:GetPlayers()) do
		if p ~= LocalPlayer then clearESP(p) if espEnabled then createESP(p) end end
	end
end)

local function setupPlayer(player)
	player.CharacterAdded:Connect(function() task.wait(0.5) if espEnabled then createESP(player) end end)
	player.CharacterRemoving:Connect(function() clearESP(player) end)
	player.AncestryChanged:Connect(function(_,parent) if not parent then clearESP(player) end end)
end
for _,p in pairs(Players:GetPlayers()) do if p~=LocalPlayer then setupPlayer(p) end end
Players.PlayerAdded:Connect(setupPlayer)
Players.PlayerRemoving:Connect(clearESP)

