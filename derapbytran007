-- ESP toggle
local espBtn = Instance.new("TextButton", frame)
espBtn.Size = UDim2.new(0,120,0,30)
espBtn.Position = UDim2.new(0.05,0,0.02,0)
espBtn.Text = "ESP: ON"
Instance.new("UICorner", espBtn)
local espEnabled = true
espBtn.MouseButton1Click:Connect(function()
    espEnabled = not espEnabled
    espBtn.Text = "ESP: "..(espEnabled and "ON" or "OFF")
end)

-- Minimize / close behavior
local lastPos = frame.Position
closeBtn.MouseButton1Click:Connect(function()
    lastPos = frame.Position
    frame.Visible = false
    minBtn.Visible = true
end)
minBtn.MouseButton1Click:Connect(function()
    frame.Position = lastPos
    frame.Visible = true
    minBtn.Visible = false
end)

-- Drag min button
do
    local dragging, startPos, startBtn
    minBtn.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = true
            startPos = input.Position
            startBtn = minBtn.Position
            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then dragging=false end
            end)
        end
    end)
    UIS.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType==Enum.UserInputType.MouseMovement) then
            local delta = input.Position - startPos
            minBtn.Position = UDim2.new(startBtn.X.Scale,startBtn.X.Offset+delta.X,startBtn.Y.Scale,startBtn.Y.Offset+delta.Y)
        end
    end)
end

-- NPC tracking
local NPCs = {}
W.ChildAdded:Connect(function(c) if c:IsA("Model") then NPCs[c]=true end end)
W.ChildRemoved:Connect(function(c) if NPCs[c] then NPCs[c]=nil end end)

-- Hit function
local function hit(target, handle)
    local hum = target.Parent:FindFirstChildOfClass("Humanoid")
    if hum and target.Parent.Name ~= P.Name then
        for _,p in pairs(target.Parent:GetChildren()) do
            if p:IsA("BasePart") then
                firetouchinterest(p,handle,0)
                firetouchinterest(p,handle,1)
            end
        end
    end
end

-- Visual part for player hitbox
