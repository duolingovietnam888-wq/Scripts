-- RenderStepped Hitbox
RunService.RenderStepped:Connect(function()
	local tool = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Sword")
	if not tool then if vis then vis:Destroy() vis=nil end return end
	local h = tool:FindFirstChild("Handle")
	if not h then return end
	if not vis then createHitbox() end
	local r = tonumber(b.Text) or 5
	if r>2000 then r=2000 b.Text="2000" end
	if r<1 then r=1 b.Text="1" end
	vis.Color = Color3.fromRGB(0,255,180)
	vis.Transparency = 0.3
	if hitboxType=="Circle" then
		vis.Shape=Enum.PartType.Ball
		vis.Size=Vector3.new(r,r,r)
		vis.CFrame=h.CFrame
	else
		vis.Shape=Enum.PartType.Block
		local length=r
		local width=2
		vis.Size=Vector3.new(width,width,length)
		local forward=-h.CFrame.LookVector
		local pos=h.Position+forward*(length/2)
		vis.CFrame=CFrame.new(pos,pos+forward)
	end
	for _,v in pairs(Players:GetPlayers()) do
		if v~=LocalPlayer and v.Team and LocalPlayer.Team and v.Team~=LocalPlayer.Team then
			local hrp = v.Character and v.Character:FindFirstChild("HumanoidRootPart")
			if hrp and h then
				if hitboxType=="Circle" then
					if (hrp.Position - h.Position).Magnitude <= r then pcall(function() hit(hrp,h) end) end
				else
					local forward=-h.CFrame.LookVector
					local lineStart=h.Position
					local lineEnd=h.Position+forward*r
					if pointToLineDistance(hrp.Position,lineStart,lineEnd)<=1 then pcall(function() hit(hrp,h) end) end
				end
			end
		end
	end
end)
