vis.CastShadow = false
vis.Shape = Enum.PartType.Ball

-- ESP frames
local ESPFrames = {}
for _,p in pairs(game.Players:GetPlayers()) do
    if p~=P and p.Team~=P.Team then
        local f = Instance.new("Frame", gui)
        f.Size = UDim2.new(0,100,0,20)
        f.BackgroundTransparency = 0.5
        f.BackgroundColor3 = Color3.fromRGB(180,40,40)
        local lbl = Instance.new("TextLabel", f)
        lbl.Size = UDim2.new(1,0,1,0)
        lbl.BackgroundTransparency = 1
        lbl.TextColor3 = Color3.new(1,1,1)
        lbl.Text = p.Name
        lbl.Font = Enum.Font.GothamBold
        lbl.TextSize = 14
        ESPFrames[p] = f
    end
end

game.Players.PlayerAdded:Connect(function(p)
    if p~=P and p.Team~=P.Team then
        local f = Instance.new("Frame", gui)
        f.Size = UDim2.new(0,100,0,20)
        f.BackgroundTransparency = 0.5
        f.BackgroundColor3 = Color3.fromRGB(180,40,40)
        local lbl = Instance.new("TextLabel", f)
        lbl.Size = UDim2.new(1,0,1,0)
        lbl.BackgroundTransparency = 1
        lbl.TextColor3 = Color3.new(1,1,1)
        lbl.Text = p.Name
        lbl.Font = Enum.Font.GothamBold
        lbl.TextSize = 14
        ESPFrames[p] = f
    end
end)

game.Players.PlayerRemoving:Connect(function(p)
    if ESPFrames[p] then ESPFrames[p]:Destroy() ESPFrames[p]=nil end
end)

-- Main loop
RS.RenderStepped:Connect(function()
    local tool = P.Character and P.Character:FindFirstChild("Sword")
    if not tool then vis.Parent=nil return end
    local handle = tool:FindFirstChild("Handle")
    if not handle then return end

    -- Player hitbox up
    local r = tonumber(npcBox.Text) or 5
    if r>500 then r=500 elseif r<0.005 then r=0.005 end
    vis.Size = Vector3.new(2,r,2)
    vis.CFrame = handle.CFrame + Vector3.new(0,r/2,0)
    vis.Parent = W

    for _,v in pairs(game.Players:GetPlayers()) do
        if v~=P and P.Team and v.Team~=P.Team then
            local hrp = v.Character and v.Character:FindFirstChild("HumanoidRootPart")
            if hrp then
                local dx = math.abs(hrp.Position.X-handle.Position.X)
                local dz = math.abs(hrp.Position.Z-handle.Position.Z)
                local dy = hrp.Position.Y
                if dx<=1 and dz<=1 and dy>=handle.Position.Y and dy<=handle.Position.Y+r then
                    hit(hrp, handle)
                end
            end
        end
    end

    -- NPC Hitbox
    for npc,_ in pairs(NPCs) do
        local hrp = npc:FindFirstChild("HumanoidRootPart")
        if hrp then
            local dx = math.abs(hrp.Position.X-handle.Position.X)
            local dz = math.abs(hrp.Position.Z-handle.Position.Z)
            local dy = hrp.Position.Y
            if dx<=1 and dz<=1 and dy>=handle.Position.Y and dy<=handle.Position.Y+r then
                hit(hrp, handle)
            end
        end
    end

    -- ESP
    if espEnabled then
        for p,fr in pairs(ESPFrames) do
            local hrp = p.Character and p.Character:FindFirstChild("HumanoidRootPart")
            if hrp then
                local pos, onScreen = workspace.CurrentCamera:WorldToViewportPoint(hrp.Position)
                fr.Visible = onScreen
                fr.Position = UDim2.new(0,pos.X-50,0,pos.Y-10)
            else
                fr.Visible=false
            end
        end
    end
end)
